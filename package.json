{
  "name": "forge-ai-roblox",
  "version": "0.2.1",
  "private": true,
  "description": "Local Roblox Studio AI builder with Gemini chat and Claude Desktop MCP bridge",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env FORGE_DEV=1 electron .\"",
    "build": "vite build && esbuild electron/bridge-server.cjs --bundle --platform=node --format=cjs --packages=bundle --outfile=dist-electron/bridge-server.cjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/studio.cjs && node --check electron/bridge-server.cjs && node --check electron/gemini-agent.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "@google/genai": "^2.32.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "gg.forgeai.desktop",
    "productName": "FORGE AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "dist-electron/bridge-server.cjs",
        "to": "bridge-server.cjs"
      }
    ]
  }
}
